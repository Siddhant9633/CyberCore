# ============================================================
# CYBERCORE Backend Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file to version control.
# ============================================================

# --- Application ---
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_SECRET_KEY=CHANGE_ME_GENERATE_A_STRONG_SECRET_KEY_HERE

# --- CORS ---
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# --- Supabase ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# --- VirusTotal ---
# Get at: https://www.virustotal.com/gui/my-apikey
VIRUSTOTAL_API_KEY=your-virustotal-api-key

# --- Google Safe Browsing ---
# Get at: https://developers.google.com/safe-browsing/v4/get-started
GOOGLE_SAFE_BROWSING_API_KEY=your-gsb-api-key

# --- Have I Been Pwned ---
# Get at: https://haveibeenpwned.com/API/Key (optional — we use the k-anon range API which needs no key)
HIBP_API_KEY=optional-hibp-api-key

# --- PhishTank ---
# Get at: https://www.phishtank.com/developer_info.php
PHISHTANK_API_KEY=your-phishtank-app-key

# --- AI Provider (choose one) ---
OPENAI_API_KEY=your-openai-key
GEMINI_API_KEY=your-gemini-key
AI_PROVIDER=gemini   # 'openai' or 'gemini'
AI_MODEL=gemini-1.5-flash   # model name for chosen provider

# --- Redis (optional caching) ---
REDIS_URL=redis://localhost:6379

# --- Rate Limiting ---
RATE_LIMIT_PER_MINUTE=30
RATE_LIMIT_SCAN_PER_HOUR=100
